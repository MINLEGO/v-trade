    {
      "name": "web_search",
      "classification": "inferred",
      "observed_name": true,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "max_highlight_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15000,
            "default": 1500,
            "description": "Maximum characters returned in highlights per result. The product with num_results must not exceed 15000."
          },
          "num_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 10
          },
          "start_published_date": {
            "type": [
              "integer",
              "string"
            ],
            "minimum": 0,
            "format": "date",
            "default": 30,
            "description": "Range start as non-negative days back from now or YYYY-MM-DD."
          },
          "end_published_date": {
            "type": [
              "integer",
              "string"
            ],
            "minimum": 0,
            "format": "date",
            "default": 0,
            "description": "Range end as non-negative days back from now or YYYY-MM-DD."
          }
        },
        "required": [
          "query"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "published_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "url",
                "published_at",
                "content"
              ]
            }
          }
        },
        "required": [
          "query",
          "results"
        ]
      }
    },
    {
      "name": "fetch_webpage",
      "classification": "inferred",
      "observed_name": true,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "result_type": {
            "type": "string",
            "enum": [
              "full_text",
              "highlights"
            ],
            "default": "highlights"
          },
          "highlight_query": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "default": null,
            "description": "Query guiding highlight selection. It is invalid when result_type is full_text."
          },
          "max_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12000,
            "default": 4000,
            "description": "Maximum characters returned from the webpage content."
          }
        },
        "required": [
          "url"
        ]
      },
      "output_schema": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {"type": "string"},
              "url": {"type": "string"},
              "published_at": {"type": ["string", "null"]},
              "author": {"type": ["string", "null"]},
              "full_text": {"type": "string"}
            },
            "required": ["title", "url", "published_at", "author", "full_text"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {"type": "string"},
              "url": {"type": "string"},
              "published_at": {"type": ["string", "null"]},
              "author": {"type": ["string", "null"]},
              "highlights": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["title", "url", "published_at", "author", "highlights"]
          }
        ]
      }
    },
