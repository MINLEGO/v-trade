          "bids": {"type": "array", "items": {"$ref": "#/$defs/orderbook_level"}},
          "asks": {"type": "array", "items": {"$ref": "#/$defs/orderbook_level"}},
          "best_bid": {"type": ["string", "null"]},
          "best_ask": {"type": ["string", "null"]},
          "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
