          "cursor": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque cursor returned by the preceding discovery page."
          },
          "hours_back": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "min_liquidity": {
            "type": "number",
            "minimum": 0
          },
          "min_volume_24hr": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": []
