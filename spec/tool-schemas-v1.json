{
  "schema_version": "predictionarena-tools-v1",
  "evidence_cutoff": "2026-07-13",
  "notice": "Names and observed argument keys come from public traces. Types, required fields, bounds and outputs are inferred V-Trade contracts.",
  "$defs": {
    "market_discovery_card": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "market_ref": {"type": "string", "minLength": 1},
        "question": {"type": "string"},
        "closes_at": {"type": ["string", "null"]},
        "volume_24h_micros": {"type": "integer"},
        "liquidity_micros": {"type": "integer"},
        "status": {"type": "string"},
        "tradeable": {"type": "boolean"},
        "competitive": {"type": "number"},
        "tag_names": {
          "type": "array",
          "items": {"type": "string"}
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": {"type": "string"},
              "indicative_price": {"type": "string"}
            },
            "required": ["name", "indicative_price"]
          }
        }
      },
      "required": [
        "market_ref", "question", "closes_at", "volume_24h_micros",
        "liquidity_micros", "status", "tradeable", "competitive", "tag_names", "outcomes"
      ]
    },
    "market_discovery_page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as_of": {"type": "string", "format": "date-time"},
        "markets": {
          "type": "array",
          "items": {"$ref": "#/$defs/market_discovery_card"}
        },
        "next_cursor": {"type": ["string", "null"]},
        "has_more": {"type": "boolean"},
        "payload_truncated": {"type": "boolean"}
      },
      "required": ["as_of", "markets", "next_cursor", "has_more", "payload_truncated"]
    },
    "event_group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "markets": {
          "type": "array",
          "items": {"$ref": "#/$defs/market_discovery_card"}
        },
        "volume_24hr_micros": {"type": "integer"},
        "total_volume_micros": {"type": "integer"},
        "newest_market_created_at": {"type": ["string", "null"]}
      },
      "required": [
        "event_id", "markets", "volume_24hr_micros",
        "total_volume_micros", "newest_market_created_at"
      ]
    },
    "event_discovery_page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as_of": {"type": "string", "format": "date-time"},
        "events": {
          "type": "array",
          "items": {"$ref": "#/$defs/event_group"}
        },
        "next_cursor": {"type": ["string", "null"]},
        "has_more": {"type": "boolean"},
        "payload_truncated": {"type": "boolean"}
      },
      "required": ["as_of", "events", "next_cursor", "has_more", "payload_truncated"]
    },
    "orderbook_level": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "price": {"type": "string"},
        "size": {"type": "string"}
      },
      "required": ["price", "size"]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position_id": {"type": "string", "format": "uuid"},
        "market_id": {"type": "string", "format": "uuid"},
        "market_question": {"type": "string"},
        "outcome_id": {"type": "string", "format": "uuid"},
        "venue_token_id": {"type": "string", "minLength": 1},
        "outcome": {"type": "string"},
        "shares": {"type": "string"},
        "average_cost": {"type": "string"},
        "cost_basis_micros": {"type": "integer"},
        "realized_pnl_micros": {"type": "integer"},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "required": [
        "position_id", "market_id", "market_question", "outcome_id", "venue_token_id",
        "outcome", "shares", "average_cost", "cost_basis_micros",
        "realized_pnl_micros", "updated_at"
      ]
    },
    "portfolio_after": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"type": "integer", "minimum": 0},
        "cash_micros": {"type": "integer"},
        "affected_position": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "outcome_id": {"type": "string"},
            "shares": {"type": "string"},
            "average_cost": {"type": "string"},
            "cost_basis_micros": {"type": "integer"}
          },
          "required": ["outcome_id", "shares", "average_cost", "cost_basis_micros"]
        }
      },
      "required": ["version", "cash_micros", "affected_position"]
    },
    "belief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "active": {"type": "boolean"},
        "confidence": {"type": "string"},
        "content": {"type": "string"},
        "category": {
          "type": "string",
          "enum": [
            "event_analysis", "trading_strategy", "market_sentiment",
            "market_structure", "risk_assessment"
          ]
        },
        "evidence": {"type": "array", "items": {"type": "string"}},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "required": ["id", "confidence", "content", "category", "evidence", "created_at"]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "plan_type": {"type": "string", "enum": ["long_term", "next_cycle"]},
        "status": {"type": "string", "enum": ["active", "completed", "cancelled"]},
        "due_at": {"type": ["string", "null"], "format": "date-time"},
        "content": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "required": ["id", "plan_type", "status", "due_at", "content", "created_at"]
    }
  },
  "tools": [
    {
      "name": "get_newest_markets",
